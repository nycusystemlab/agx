# ==============================================================================
#  多人開發環境變數
#
#  複製成 .env 並依個人調整：  cp .env.example .env
#  compose 會自動讀取同目錄的 .env，所有變數都有預設值，
#  不建 .env 時行為與單人時期完全相同。
# ==============================================================================

# ---- DDS 隔離 ---------------------------------------------------------------
# 每人一組 domain，否則同網段的兩個人會互相收到對方的 /cmd_vel。
# 建議 ROS_DOMAIN_ID = uid - 1000 + 1（systemlab / systemlabagx 保留 0）。
# Isaac Sim 端用 ROS_DOMAIN_ID + 30，由 domain_bridge 白名單轉發（per-user 轉發
# 已實作，設定在 amr_simulate 的 docker/isaacsim/.env，見 docs/multiuser.md）。
ROS_DOMAIN_ID=0

# ---- 容器命名 ---------------------------------------------------------------
# 同一台 docker daemon 上，container_name 相同會直接撞名。
# 多人時設成 "${USER}_"，例如 alice_planning、alice_foxglove。
# 留空則維持 planning / foxglove / vlm …，現有的 docker exec planning 不受影響。
CONTAINER_PREFIX=

# ---- foxglove_bridge 連接埠 -------------------------------------------------
# network_mode: host 之下，多人同時開會搶同一個 port。
# 建議 FOXGLOVE_PORT = 8765 + ROS_DOMAIN_ID。
FOXGLOVE_PORT=8765

# ---- 路徑（AGX 實機用）------------------------------------------------------
# .agx.yaml 系列 override 掛載的實機路徑。每人各自 clone 時指到自己的位置。
AGX_PROJECT_ROOT=/home/systemlabagx/disk/agx
AGX_WORKSPACES=/home/systemlabagx/disk/workspaces

# ---- 中介軟體（rmw）---------------------------------------------------------
# planning 與 foxglove 的映像同時裝了兩套 rmw，切換不需要重建映像。
# 不設定時是 rmw_cyclonedds_cpp，行為與遷移前完全相同。
#   rmw_cyclonedds_cpp  現行預設，也是遷移期的退路
#   rmw_zenoh_cpp       需要兩端各有一個 zenohd router 在跑，否則節點起得來但收不到資料
#
# 變數刻意不叫 RMW_IMPLEMENTATION：compose 的插值優先讀 shell 環境，而 Isaac Sim
# 的啟動流程本身就要 export RMW_IMPLEMENTATION（見 CLAUDE.md），同名會讓這裡靜默失效。
#
# ⚠️ 只影響 planning / foxglove。這些仍是 CycloneDDS，切過去就跟它們斷了：
#      - Isaac Sim（跑在 host，讀不到這個 .env）→ Nav2 的 sim 驗證流程整條不通，
#        症狀就是 CLAUDE.md 開頭那串 Timed out waiting for transform / Publisher count = 0
#      - cosmos（VLA）、vlm、nanollm
# ⚠️ 車上切 rmw_zenoh_cpp 前要先停掉 zenoh-bridge：兩者都預設 listen 7447，
#    不停的話 zenohd 直接 Address already in use（實測見 spec 的 arm64 spike）。
# AGX_RMW=rmw_cyclonedds_cpp

# ---- zenoh bridge（SIM ↔ 實車的 ROS 2 橋接）---------------------------------
# 兩端跑同一個 service、但用不同設定檔：車端 listen、SIM 端 connect。
# 設定檔本身放 zenoh/ 底下（已 gitignore），來源是 infra repo 的 robot-net/zenoh/。
# 車上（AGX）用預設值即可；在 SIM 上必須改成 sim-bridge.json5。
ZENOH_BRIDGE_CONFIG=robot-bridge.json5

# ---- 選用 -------------------------------------------------------------------
# cosmos 拉 HuggingFace 模型時需要
# HF_TOKEN=
# zenoh bridge 的 log 等級（排查「橋起來了但 topic 沒過」時開 debug）
# ZENOH_LOG=zenoh=debug,zenoh_plugin_dds=debug
