# ==============================================================================
#  多人開發環境變數
#
#  複製成 .env 並依個人調整：  cp .env.example .env
#  compose 會自動讀取同目錄的 .env，所有變數都有預設值。
# ==============================================================================

# ---- domain 隔離 ------------------------------------------------------------
# 每人一組 domain，否則同網段的兩個人會互相收到對方的 /cmd_vel。
# rmw_zenoh 下 domain 仍然有效：它是 keyexpr 的第一段（0/scan/...），不同 domain
# 天生互不可見。但跨機白名單的 keyexpr 寫死 0/…，所以**跨機目前只有 domain 0 會通**
# ——多人隔離是本次刻意擱置的範圍（見 docs/multiuser.md）。
# 建議 ROS_DOMAIN_ID = uid - 1000 + 1（systemlab / systemlabagx 保留 0）。
# Isaac Sim 端仍是 ROS_DOMAIN_ID + 30，由 domain_bridge 轉發（per-user 已實作，
# 設定在 amr_simulate 的 docker/isaacsim/.env，見 docs/multiuser.md）。
# 那個 +30 隔離原本是為了繞開 Isaac 與 agx 的 type metadata 不合，2026-08-24 查出
# 真正原因是 Isaac 預設載 jazzy backend；指定 ROS_DISTRO=humble 之後兩端同世代，
# Isaac 可以直接跑在同一個 domain、domain_bridge 整個移除。**尚未決定是否採用**，
# 所以上面寫的仍是現況——要改是 amr_simulate 那邊的事，不是這裡。
ROS_DOMAIN_ID=0

# ---- 容器命名 ---------------------------------------------------------------
# 同一台 docker daemon 上，container_name 相同會直接撞名。
# 多人時設成 "${USER}_"，例如 alice_planning、alice_foxglove。
# 留空則維持 planning / foxglove / vlm …，現有的 docker exec planning 不受影響。
CONTAINER_PREFIX=

# ---- foxglove_bridge 連接埠 -------------------------------------------------
# network_mode: host 之下，多人同時開會搶同一個 port。
# 建議 FOXGLOVE_PORT = 8765 + ROS_DOMAIN_ID。
FOXGLOVE_PORT=8765

# ---- 路徑（AGX 實機用）------------------------------------------------------
# .agx.yaml 系列 override 掛載的實機路徑。每人各自 clone 時指到自己的位置。
AGX_PROJECT_ROOT=/home/systemlabagx/disk/agx
AGX_WORKSPACES=/home/systemlabagx/disk/workspaces

# ---- 中介軟體（rmw）---------------------------------------------------------
# planning 與 foxglove 的映像同時裝了兩套 rmw，切換不需要重建映像。
#   rmw_zenoh_cpp       planning 與 foxglove 的預設，需要本機有一個 zenohd router 在跑，
#                       否則節點起得來但收不到資料（症狀見下面最後一則 ⚠️）。
#                       router **不在本 repo**：它是機器層級的 systemd unit（rmw-zenohd），
#                       設定與安裝腳本在 infra repo 的 robot-net/zenoh/。
#   rmw_cyclonedds_cpp  遷移期的退路，永久保留；設了這個就完全回到遷移前的行為
#
# 變數刻意不叫 RMW_IMPLEMENTATION：compose 的插值優先讀 shell 環境，而 Isaac Sim
# 的啟動流程本身就要 export RMW_IMPLEMENTATION（見 CLAUDE.md），同名會讓這裡靜默失效。
#
# ⚠️ 只影響 planning / foxglove。這些仍是 CycloneDDS，planning 用 zenoh 時跟它們是斷的：
#      - Isaac Sim（跑在 host，讀不到這個 .env）→ Nav2 的 sim 驗證流程整條不通，
#        症狀就是 CLAUDE.md 開頭那串 Timed out waiting for transform / Publisher count = 0。
#        **在 SIM 上跑 Nav2 驗證流程時，這裡要設成 rmw_cyclonedds_cpp。**
#      - cosmos（VLA）、vlm、nanollm
# ⚠️ foxglove 只看得到「同一台機器」上的 topic。跨機的 topic 不會出現在它的清單裡：
#    SIM↔車 那條連線上的 keyexpr 白名單用 access_control 的 default_permission: "deny"，
#    這個預設一生效，rmw_zenoh 的 graph 資訊（@ros2_lv/… liveliness token）就不跨機，
#    沒有任何規則救得回來（infra repo robot-net/GUIDE.md 有實測表）。foxglove_bridge
#    靠 ROS graph 問「有哪些 topic、什麼型別」才去訂閱，問不到就不訂閱、畫面上就沒有。
#    這是已決定的取捨（留白名單），不是設定錯了。要看對面機器的資料就指定型別：
#      ros2 topic echo <topic> <型別>   ← 資料是通的，只有 graph 不通
# ⚠️ 沒有 router 時 rmw_zenoh 只印一則 WARN 就照常初始化：
#      Unable to connect to a Zenoh router. Have you started a router with ...
#    ros2 topic list 還是列得出名稱，症狀是「topic 有、就是沒資料」。
#    排查表見 docs/multiuser.md 的「跨機通訊 → 啟動與排查」。
# AGX_RMW=rmw_zenoh_cpp

# ---- 選用 -------------------------------------------------------------------
# cosmos 拉 HuggingFace 模型時需要
# HF_TOKEN=
