# ==========================
# 1. 作業系統垃圾 (OS Junk)
# ==========================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux / Mac
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*~

# ==========================
# 2. 開發工具與 IDE (Editor)
# ==========================
# VS Code 
.vscode/

# JetBrains (CLion, PyCharm)
.idea/

# ==========================
# 3. 編譯產出 (Build Artifacts)
# ==========================
# ROS 1 & ROS 2 標準編譯目錄
build/
devel/
install/
log/
.catkin_workspace

# C++ 編譯檔
*.o
*.obj
*.so
*.so.*
*.a
*.lib
*.dll
*.exe
*.out
*.app

# CMake 產生的暫存檔
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ==========================
# 4. Python 相關
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.venv
venv/
env/

# ==========================
# 5. 大型數據與日誌 (Safety Net)
# ==========================
# 預設忽略所有大型資料，避免不小心 push 上去
# 如果特定檔案需要保留，請在該資料夾內建立 .gitignore 使用 ! 排除
*.bag
*.pcd
*.ply
*.las
*.h5
*.weights
*.pt
*.pth
*.onnx
*.zip
*.mp4

# GroundingDINO 權重與上游 clone（過大，不進版控；.pth 分片檔名不符 *.pth 規則所以另外列）
vlm/grounding_test/weights/
vlm/grounding_test/GroundingDINO/

# 系統日誌
*.log

# Claude Code
tmpclaude-*
.claude/settings.local.json
.codex
CLAUDE.md

# 多人開發：每人的 compose 變數（domain、container 前綴、路徑）各自不同
.env
!.env.example
# 多人開發：機器位址與帳號對應表，不進版控
docs/multiuser.local.md

# zenoh bridge 舊設定檔：檔案本身已隨橋接移除，但車與 SIM 的既有 checkout 仍留著
# infra 產生的 robot-bridge.json5 / sim-bridge.json5（帶 wg 位址），規則拿掉就會被 git add -A 收進來
zenoh/*.json5

# /to-spec、/to-tickets 的本地中間產物（最終歸宿是 GitHub issue）
.scratch/
